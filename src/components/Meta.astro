---
import type { CollectionEntry } from "astro:content";

const metaLabel = {
  "team": "개발 인원",
  "stack": "사용 스택",
  "tag": "태그",
  "platform": "플랫폼"
}

type Props = {
  post: CollectionEntry<"portfolio">;
  order?: (keyof typeof metaLabel)[];
};

const { post, order = ["team", "stack", "tag", "platform"] } = Astro.props;

const labelClass = "pt-1 text-[0.9rem] font-extrabold text-[#5f5f5f]";
const listClass = "flex flex-wrap gap-1.5";
const chipClass =
  "inline-block rounded-full border border-[#099f93] px-[9px] py-[3px] text-[0.9rem] font-semibold text-[#099f93]";
---

<div class="grid grid-cols-[auto_1fr] gap-x-[18px] gap-y-2">
  <div class={labelClass}>사용 스택</div>
  <div class={listClass}>
    {post.data.stack.map((v) => <span class={chipClass}>{v}</span>)}
  </div>
  <div class={labelClass}>태그</div>
  <div class={listClass}>
    {post.data.tag.map((v) => <span class={chipClass}>{v}</span>)}
  </div>
  <div class={labelClass}>플랫폼</div>
  <div class={listClass}>
    {post.data.platform.map((v) => <span class={chipClass}>{v}</span>)}
  </div>
</div>
